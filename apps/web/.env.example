# Browser-safe Supabase configuration. These identify the project but do not grant
# privileged access. Use the values shown in the Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials. Never prefix these with NEXT_PUBLIC_ and never commit
# real values. Configure them in the cloud deployment environment.
SUPABASE_SECRET_KEY=
SOURCE_INGESTION_SECRET=
MONITOR_ALERT_WEBHOOK_URL=
